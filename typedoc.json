{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Clovervale",
  "entryPointStrategy": "packages",
  "entryPoints": ["packages/*"],
  "packageOptions": {
    "entryPointStrategy": "expand",
    "entryPoints": ["src"],
    "disableSources": true
  },
  "projectDocuments": ["docs/deploy.md"],
  "plugin": [
    "./scripts/typedoc-module-summary.ts",
    "./scripts/typedoc-language-links.ts"
  ],
  "otherLanguage": {
    "name": "正體中文",
    "root": "zh-tw/",
    "pages": {
      "documents/Running_and_Deploying.html": "documents/執行與部署.html"
    }
  },
  "out": "docs/api",
  "treatWarningsAsErrors": true
}
