# The .env configuration file for the headless bots of the Clovervale Project
# File location： /etc/node/clovervale.bots.conf
#
# The bots read .env from their working directory when they start, if
# there is one.  Make that a symbolic link to this file:
#   ln -s /etc/node/clovervale.bots.conf /srv/www/clovervale/bots/.env
# The user of the bots must be able to read this file.  An environment
# variable of the same name takes precedence over a setting here, and a
# command-line option over both.

# The WebSocket URL of the game server.  When it is not set, the bots
# connect to ws://localhost:8080.  The --server option takes precedence
# over it.  The bots go through the web server like any player, so it is
# the address that the client connects to.
SERVER_URL=wss://clovervale.example.com/ws

# The number of bots, from 1.  When it is not set, there are 4 bots.  The
# --count option takes precedence over it.
BOT_COUNT=4
