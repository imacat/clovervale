# The .env configuration file for the browser client of the Clovervale Project
# File location： /etc/node/clovervale.client.conf
#
# The page fetches client.conf from its own directory on the web site when
# it starts, if there is one.  Make that a symbolic link to this file:
#   ln -s /etc/node/clovervale.client.conf \
#     /srv/www/clovervale/client/client.conf
# The user of the web server must be able to read this file.  This file is
# public: everyone who can open the page can read it.  Never put a secret
# in it.

# The WebSocket URL of the game server.  When it is not set, the page
# connects to port 8080 of the host that serves it.  The "server" query
# parameter of the page address takes precedence over it.  It must agree
# with ServerName and ProxyPass in the Apache virtual host.
SERVER_URL=wss://www.example.com/ws
